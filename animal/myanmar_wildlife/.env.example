# Answers in member chat are generated by DeepSeek (OpenAI-compatible API).
# Server-side only: this key is never sent to the browser.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1600

# Used only by administrators while publishing or rebuilding the local index.
# Never expose this key in browser JavaScript or member-facing forms.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536
OPENAI_EMBED_TIMEOUT=60
OPENAI_EMBED_BATCH_SIZE=64
EMBED_ENABLED=1
EMBED_THRESHOLD=0.55
# Optional Wikipedia retrieval helper settings. Member chat uses DeepSeek's
# general-knowledge fallback when its published record has no answer.
EXTERNAL_SOURCES_ENABLED=1
EXTERNAL_TIMEOUT=12
EXTERNAL_CACHE_TTL=86400

APP_HOST=127.0.0.1
APP_PORT=2000
SECRET_KEY=replace-this-for-production
ADMIN_EMAILS=admin@example.com
# Total request limit for admin photo uploads (default: 12 MiB)
MAX_UPLOAD_BYTES=12582912

# Optional: point the app at a different SQLite file (handy for demos/tests)
# DATABASE=/absolute/path/to/wildlife.db
